{
  "glen-pure-bare-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v glen >/dev/null 2>&1 && glen hook pre-tool-use --agent=agy || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
